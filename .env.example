# MyHumNews — environment template.
#
#   cp .env.example .env     then fill in the real values
#
# .env is gitignored; this template is not, so the variable names survive a
# clone while the secrets do not. rag/generate.py loads .env automatically and
# does NOT override anything already set in the shell, so an exported value
# always wins over the file.

# ---------------------------------------------------------------- required
# Free key, no payment method needed: https://aistudio.google.com/apikey
# Used by rag/generate.py for the English-answer generation step.
GEMINI_API_KEY=your-key-here

# ---------------------------------------------------------------- optional
# Model names change and old ones get retired, so do not trust the default.
# Run `python rag/generate.py --list-models` and paste one of its names here.
# GEMINI_MODEL=

# Only needed if the dataset is uploaded from this machine.
# https://huggingface.co/settings/tokens  (a WRITE token)
# HF_TOKEN=hf_...
